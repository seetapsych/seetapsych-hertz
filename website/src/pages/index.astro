---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Demo from '../components/Demo.astro';
import Method from '../components/Method.astro';
import Results from '../components/Results.astro';
import Resources from '../components/Resources.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="HERTZ | rPPG heart-rate estimation from facial video"
  description="HERTZ is an extensible open-source collection of facial-video rPPG heart-rate estimators, including TinyHR and AdaChrom."
>
  <Header lang="en" />
  <main id="main">
    <Hero lang="en" />
    <Highlights lang="en" />
    <Demo lang="en" />
    <Method lang="en" />
    <Results lang="en" />
    <Resources lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
