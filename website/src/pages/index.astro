---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import Method from '../components/Method.astro';
import Results from '../components/Results.astro';
import Resources from '../components/Resources.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="SeetaPsych Hertz | TinyHR Video-Based Heart-Rate Estimation"
  description="Explore TinyHR, a lightweight model for estimating pulse waveforms and heart rate from facial video. Watch the demo, inspect the method, and access the code."
>
  <Header />
  <main id="main">
    <Hero />
    <Demo />
    <Method />
    <Results />
    <Resources />
  </main>
  <Footer />
</BaseLayout>
