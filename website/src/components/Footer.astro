---
import { site } from '../data/site';

interface Props { lang?: 'en' | 'zh'; }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <strong>{site.brand}</strong>
      <p>{site.model} · {zh ? '基于人脸视频的心率估计' : 'Heart-rate estimation from facial video'}</p>
      <p class="template-credit">Website design adapted from <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" target="_blank" rel="noopener noreferrer" aria-label="Open Academic Project Page Template in a new tab">Academic Project Page Template</a> and <a href="https://nerfies.github.io/" target="_blank" rel="noopener noreferrer" aria-label="Open Nerfies in a new tab">Nerfies</a>. Adapted website design: <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Open the CC BY-SA 4.0 license in a new tab">CC BY-SA 4.0</a>.</p>
    </div>
    <a href="#top">{zh ? '返回顶部' : 'Back to top'} <span aria-hidden="true">↑</span></a>
  </div>
</footer>
