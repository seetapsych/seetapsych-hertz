---
import { site } from '../data/site';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">HERTZ / OPEN-SOURCE RPPG</p>
      <h1 id="hero-title">{zh ? '面向人脸视频的 rPPG 心率估计技术' : 'rPPG Heart-Rate Estimation from Facial Video'}</h1>
      <p class="hero-description">{zh ? 'HERTZ 是一个可扩展的开源算法集合，组织互补的人脸视频 rPPG 心率估计方法：TinyHR 从视频学习脉搏波形，AdaChrom 通过无需训练的色度信号处理恢复脉搏信号。' : 'HERTZ is an extensible open-source collection of complementary facial-video rPPG estimators: TinyHR learns pulse waveforms from video, while AdaChrom recovers pulse signals through training-free chrominance-based processing.'}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#demo">{zh ? '观看演示' : 'Watch demo'}</a>
        <a class="button button-secondary" href={site.repoUrl} target="_blank" rel="noopener noreferrer" aria-label="Open the code on GitHub in a new tab">
          {zh ? '查看代码' : 'Code on GitHub'} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link text-link-light" href={site.reportUrl} target="_blank" rel="noopener noreferrer" aria-label="Open the technical report in a new tab">{zh ? '技术报告' : 'Technical report'} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-stage">
      <p class="stage-label">{zh ? 'TINYHR 录制演示 · 12 秒预览' : 'TINYHR RECORDED DEMO · 12-SECOND PREVIEW'}</p>
      <video
        class="media-video hero-video"
        data-hero-video
        src={site.heroPreviewUrl}
        poster={site.posterUrl}
        width="856"
        height="480"
        controls
        muted
        loop
        playsinline
        preload="none"
        aria-label="TinyHR recorded preview"
      >
        Your browser does not support video playback. <a href={site.heroPreviewUrl} download>Download the preview video.</a>
      </video>
    </div>
  </div>
</section>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (heroVideo && !reduceMotion.matches) {
    heroVideo.play().catch(() => {
      // Browsers may require an explicit user gesture. Native controls remain available.
    });
  }
</script>
