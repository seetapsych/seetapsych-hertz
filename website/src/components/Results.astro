---
import { site } from '../data/site';
---

<section class="section results-section" id="results" aria-labelledby="results-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow eyebrow-dark">EVALUATION</p>
      <h2 id="results-title">Reported performance</h2>
    </div>

    <div class="results-grid">
      <div class="result-number" aria-label={`Mean absolute error ${site.maeBpm} BPM`}>
        <span>{site.maeBpm}</span>
        <strong>BPM</strong>
        <p>Mean absolute error (MAE)</p>
      </div>

      <div>
        <dl class="result-list">
          <div>
            <dt>Dataset</dt>
            <dd>{site.dataset}</dd>
          </div>
          <div>
            <dt>Test split</dt>
            <dd>{site.subjects} subjects · {site.videos} videos</dd>
          </div>
          <div>
            <dt>Evaluation protocol</dt>
            <dd>Held-out test set, excluded from training according to the report</dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd>TinyHR technical report, page {site.reportPage}</dd>
          </div>
        </dl>
        <p class="result-disclaimer">Author-reported performance on the specified test set. This value is not a per-video error bound.</p>
        <a class="text-link text-link-dark" href={`${site.reportUrl}#page=${site.reportPage}`} target="_blank" rel="noopener noreferrer" aria-label="Open the evaluation details in the technical report in a new tab">Read the evaluation details <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
